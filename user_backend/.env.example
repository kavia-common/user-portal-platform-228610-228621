# Application Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS: only allow the React frontend origin (NO credentials; Bearer JWT only)
FRONTEND_ORIGIN=http://localhost:3000

# Shared secret with API Gateway for verifying Authorization: Bearer JWTs
JWT_SECRET=change_me_to_match_gateway

# Optional: base URL for documentation/clients (not required by runtime)
APP_SERVER_BASE_URL=http://localhost:3001

# MySQL connection
DB_HOST=localhost
DB_PORT=5001
DB_USER=appuser
DB_PASSWORD=change_me
DB_NAME=myapp

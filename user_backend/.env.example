# Application Server (default port per architecture: 3001)
APP_PORT=3001
HOST=0.0.0.0

# CORS: only allow the React frontend origin (NO credentials; Bearer JWT only)
FRONTEND_ORIGIN=http://localhost:3000

# Shared secret with API Gateway for verifying Authorization: Bearer JWTs
JWT_SECRET=change_me_to_a_long_random_string

# Optional (useful for docs/clients, not strictly required by server runtime)
APP_SERVER_BASE_URL=http://localhost:3001

# MySQL connection
DB_HOST=localhost
DB_PORT=5001
DB_USER=appuser
DB_PASSWORD=dbuser123
DB_NAME=myapp
